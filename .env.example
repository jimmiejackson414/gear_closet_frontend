# Cloudinary
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_AUTH_PAGES_PATH=
NUXT_PUBLIC_CLOUDINARY_AVATARS_PATH=

# Application
NUXT_JWT_SECRET=
NUXT_TOKEN_IDENTIFIER=
NUXT_COOKIE_KEY=

# Facebook Auth
NUXT_FACEBOOK_APP_ID=
NUXT_FACEBOOK_APP_SECRET=

# Twitter Auth
NUXT_TWITTER_API_KEY=
NUXT_TWITTER_API_SECRET=

# Google Auth and Analytics
NUXT_GOOGLE_API_KEY=
NUXT_GOOGLE_API_SECRET=
NUXT_GOOGLE_ANALYTICS_ID=

# Supabase
# Prefer new API keys (publishable + secret). Legacy anon / service_role still work until deactivated.
# Local: `supabase status -o env` → PUBLISHABLE_KEY / SECRET_KEY
# Hosted: Dashboard → Settings → API Keys → create Publishable + Secret keys
#   https://supabase.com/dashboard/project/_/settings/api-keys
# Optional JWT signing keys (asymmetric): Dashboard → Settings → JWT → Signing keys
#   https://supabase.com/dashboard/project/_/settings/jwt/signing-keys
#   Independent of API key migration; enables getClaims() local verification.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=          # sb_publishable_... (or legacy anon JWT)
NUXT_SUPABASE_SECRET_KEY=          # sb_secret_... (or legacy service_role JWT) — server only
# Legacy aliases still read by @nuxtjs/supabase:
SUPABASE_URL=
SUPABASE_KEY=

# Duplicated Supabase variables for Vite / scripts
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
VITE_SUPABASE_SERVICE_KEY=         # prefer same value as NUXT_SUPABASE_SECRET_KEY

# Stripe
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET=
NUXT_STRIPE_WEBHOOK_SECRET=
# Set to true to show the Lifetime promo overlay on onboarding step 3.
NUXT_PUBLIC_LIFETIME_PROMO=

# Forums
NUXT_PUBLIC_FORUMS_URL=
NUXT_FORUMS_API_KEY=
NUXT_FORUMS_API_USERNAME=

# Playwright
NUXT_PLAYWRIGHT_BASE_URL=
NUXT_PLAYWRIGHT_USERNAME=
NUXT_PLAYWRIGHT_PASSWORD=

# Transactional email (Resend). Auth confirm/reset stays on Supabase Auth templates.
# Verify the from-domain in the Resend dashboard before sending from staging/prod.
# Server only — do not prefix these with NUXT_PUBLIC_.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Gear Closet <noreply@mail.gearcloset.io>
# Comma-separated. When set, sendMail only delivers to these addresses (use in staging).
NUXT_MAIL_ALLOWLIST=

# Sentry. Dev/local (`nuxt dev`) is off unless NUXT_PUBLIC_SENTRY_ENABLED=true
# and a DSN is set. Preview/prod send when a DSN is set, unless
# NUXT_PUBLIC_SENTRY_ENABLED=false. Server capture needs a production build
# (`pnpm build` + `pnpm preview`, or a deploy); `nuxt dev` does not init the
# server SDK. The public DSN is expected in the browser; NUXT_SENTRY_DSN is
# server-only and falls back to the public DSN if unset.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENABLED=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional. GET /api/sentry-example?key=... throws a test error when this matches.
NUXT_SENTRY_PROBE_KEY=
# Optional source-map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
