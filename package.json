{
  "name": "gear_closet_frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn codegen && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.ts",
    "cert": "mkcert -key-file ./localhost-key.pem -cert-file ./localhost.pem localhost"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.13.0",
    "@heroicons/vue": "^2.0.18",
    "@stripe/stripe-js": "^2.1.11",
    "@supabase/supabase-js": "^2.38.4",
    "@unhead/vue": "^1.8.3",
    "@vueuse/components": "^10.6.0",
    "@vueuse/core": "^10.6.0",
    "apexcharts": "^3.44.0",
    "convert": "^4.13.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dinero.js": "^1.9.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "filepond": "^4.30.4",
    "filepond-plugin-file-encode": "^2.1.11",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.8",
    "filepond-plugin-image-crop": "^2.0.6",
    "filepond-plugin-image-preview": "^4.6.11",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "lodash.round": "^4.0.4",
    "papaparse": "^5.4.1",
    "pinia": "^2.1.7",
    "preline": "^2.0.0",
    "tsc-alias": "^1.8.8",
    "tscpaths": "^0.0.9",
    "v-onboarding": "^2.6.0",
    "vee-validate": "^4.11.8",
    "vue": "^3.3.4",
    "vue-filepond": "^7.0.4",
    "vue-gtag": "^2.0.1",
    "vue-router": "^4.2.5",
    "vue3-apexcharts": "^1.4.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-graphql-request": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@kalimahapps/eslint-plugin-tailwind": "^1.0.10",
    "@playwright/test": "^1.39.0",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tsconfig/node18": "^18.2.2",
    "@types/crypto-js": "^4.2.1",
    "@types/dinero.js": "^1.9.3",
    "@types/jsdom": "^21.1.3",
    "@types/lodash.round": "^4.0.9",
    "@types/node": "^20.9.0",
    "@types/papaparse": "^5.3.11",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "eslint-plugin-vuejs-accessibility": "^2.2.0",
    "jsdom": "^22.1.0",
    "npm-run-all2": "^6.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "unplugin-auto-import": "^0.16.7",
    "vite": "^4.4.11",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.19"
  }
