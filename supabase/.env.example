# Local Auth only (`supabase start` reads this file for env() in config.toml).
# Production Google/Facebook credentials go in the hosted Dashboard:
#   Authentication → Providers
# Do not prefix these with NUXT_ / NUXT_PUBLIC_ and do not add them to Netlify.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Authorized redirect URI for local Auth: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Facebook Developers → Settings → Basic (App ID + App Secret)
# Valid OAuth Redirect URI for local Auth: http://127.0.0.1:54321/auth/v1/callback
# Enable the `email` permission under Use Cases → Authentication and account creation.
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
