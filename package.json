{
  "name": "gear-closet-frontend",
  "version": "0.0.1",
  "description": "Ever needed a way to plan the next backpacking trip with your friends? Welcome to Gear Closet! Create pack lists, plan your hike, and share your pack lists with others!",
  "productName": "Gear Closet",
  "author": "Jimmie Jackson",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev-ios": "quasar dev -m capacitor -T ios",
    "dev-android": "quasar dev -m capacitor -T android",
    "start": "quasar server",
    "build": "yarn codegen && vue-tsc --project tsconfig.json --declaration --emitDeclarationOnly && quasar build",
    "build-ios": "yarn codegen && vue-tsc --project tsconfig.json --declaration --emitDeclarationOnly && quasar build -m capacitor -T ios",
    "build-android": "yarn codegen && vue-tsc --project tsconfig.json --declaration --emitDeclarationOnly && quasar build -m capacitor -T android",
    "preserve": "quasar build",
    "clean": "rm -rf dist",
    "preview": "quasar preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "npx eslint",
    "lint:style": "stylelint src/**/*.{css,scss,vue}",
    "test": "env-cmd -f .env cypress open",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "cert": "mkcert -key-file ./localhost-key.pem -cert-file ./localhost.pem 'localhost'"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.8.7",
    "@quasar/extras": "^1.15.9",
    "@stripe/stripe-js": "^1.46.0",
    "@supabase/supabase-js": "^2.2.3",
    "@vueuse/components": "^9.10.0",
    "@vueuse/core": "^9.10.0",
    "apexcharts": "^3.36.3",
    "convert": "^4.9.0",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.7",
    "dinero.js": "^1.9.1",
    "eslint-import-resolver-typescript": "^3.5.2",
    "events": "^3.3.0",
    "filepond": "^4.30.4",
    "filepond-plugin-file-encode": "^2.1.10",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.8",
    "filepond-plugin-image-crop": "^2.0.6",
    "filepond-plugin-image-preview": "^4.6.11",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "graphql": "^16.6.0",
    "graphql-request": "^5.1.0",
    "lodash.round": "^4.0.4",
    "papaparse": "^5.3.2",
    "pinia": "^2.0.11",
    "quasar": "^2.11.5",
    "sass": "1.32.12",
    "tsc-alias": "^1.8.2",
    "tscpaths": "^0.0.9",
    "v-onboarding": "^2.2.1",
    "vue": "^3.0.0",
    "vue-facebook-login-component-next": "^1.0.4",
    "vue-filepond": "^7.0.3",
    "vue-gtag": "^2.0.1",
    "vue-router": "^4.0.0",
    "vue-tsc": "^1.0.24",
    "vue3-apexcharts": "^1.4.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^2.16.3",
    "@graphql-codegen/typescript": "^2.8.7",
    "@graphql-codegen/typescript-graphql-request": "^4.5.8",
    "@graphql-codegen/typescript-operations": "^2.5.12",
    "@quasar/app-vite": "^1.2.0",
    "@quasar/vite-plugin": "^1.3.0",
    "@types/crypto-js": "^4.1.1",
    "@types/dinero.js": "^1.9.0",
    "@types/events": "^3.0.0",
    "@types/lodash.round": "^4.0.7",
    "@types/node": "^12.20.21",
    "@types/papaparse": "^5.3.7",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "@vue/eslint-config-airbnb": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "autoprefixer": "^10.4.2",
    "cypress": "^12.3.0",
    "cypress-esbuild-preprocessor": "^1.0.2",
    "env-cmd": "^10.1.0",
    "eslint": "^8.10.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-vue": "^9.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.0.0",
    "postcss": "^8.4.21",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.6",
    "sass-loader": "^13.2.0",
    "stylelint": "^14.16.1",
    "stylelint-config-recommended": "^9.0.0",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-scss": "^4.3.0",
    "typescript": "^4.9.4",
    "vue-eslint-parser": "^9.1.0"
  },
  "engines": {
    "node": "^18 || ^16 || ^14.19",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
