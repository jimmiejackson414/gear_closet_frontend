# Cloudinary (login/register backgrounds + image URLs)
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_AUTH_PAGES_PATH=

# Cookie / query-param obfuscation
NUXT_COOKIE_KEY=

# Supabase
# Local: `supabase status -o env` → PUBLISHABLE_KEY / SECRET_KEY
# Hosted: Dashboard → Settings → API Keys
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=          # sb_publishable_... (or legacy anon JWT)
NUXT_SUPABASE_SECRET_KEY=          # sb_secret_... (or legacy service_role JWT) — server only

# Stripe
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET=
NUXT_STRIPE_WEBHOOK_SECRET=
# Set to true to show the Lifetime overlay and grant LIFE during onboarding.
# Set to false (or leave unset) to hide the overlay; new users stay on Free
# until they subscribe from Profile.
NUXT_PUBLIC_LIFETIME_PROMO=

# Transactional email (Resend). Auth confirm/reset stays on Supabase Auth templates.
# Needed for trip invite emails. Server only — do not prefix these with NUXT_PUBLIC_.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Gear Closet <noreply@mail.gearcloset.io>

# Sentry. Dev/local (`nuxt dev`) is off unless NUXT_PUBLIC_SENTRY_ENABLED=true
# and a DSN is set. Preview/prod send when a DSN is set, unless
# NUXT_PUBLIC_SENTRY_ENABLED=false. Server capture needs a production build
# (`pnpm build` + `pnpm preview`, or a deploy); `nuxt dev` does not init the
# server SDK. The public DSN is expected in the browser; NUXT_SENTRY_DSN is
# server-only and falls back to the public DSN if unset.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENABLED=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional. GET /api/sentry-example?key=... throws a test error when this matches.
NUXT_SENTRY_PROBE_KEY=
# Optional source-map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
