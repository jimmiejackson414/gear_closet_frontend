# Cloudinary (login/register backgrounds + image URLs)
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_AUTH_PAGES_PATH=

# Cookie / query-param obfuscation
NUXT_COOKIE_KEY=

# Supabase
# Local: `supabase status -o env` → PUBLISHABLE_KEY / SECRET_KEY
# Hosted: Dashboard → Settings → API Keys
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=          # sb_publishable_... (or legacy anon JWT)
NUXT_SUPABASE_SECRET_KEY=          # sb_secret_... (or legacy service_role JWT) — server only

# Social login (Google / Facebook)
# Do not put Google or Facebook app secrets in this file or in Netlify.
# The Nuxt app only calls supabase.auth.signInWithOAuth; Supabase holds the
# provider credentials and redirects back to /callback.
#
# Production (hosted project):
# 1. Dashboard → Authentication → URL Configuration
#    Site URL: https://app.gearcloset.io
#    Redirect URLs must include:
#      https://app.gearcloset.io/callback
#      http://localhost:8000/callback   (optional; only if you point nuxt dev at hosted Auth)
# 2. Dashboard → Authentication → Providers → enable Google and Facebook
#    Paste Client ID + Secret from the consoles below.
# 3. Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#    Authorized JavaScript origins:
#      https://app.gearcloset.io
#      http://localhost:8000
#    Authorized redirect URIs (this is the Supabase callback, not /callback):
#      {NUXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
#    Scopes: openid, userinfo.email, userinfo.profile
# 4. Meta for Developers → Use cases → Authentication and account creation
#    → Customize → Settings (or Facebook Login → Settings)
#    Turn ON: Client OAuth Login, Web OAuth Login
#    Valid OAuth Redirect URIs must be the Supabase Auth callback, NOT
#    https://app.gearcloset.io/callback. Add both:
#      https://<project-ref>.supabase.co/auth/v1/callback
#      http://localhost:54321/auth/v1/callback
#    Same screen: enable `email` (required; profiles.email is NOT NULL)
#    Settings → Basic: App ID + App Secret; App Domains can include
#    app.gearcloset.io (and localhost for local testing)
#    "Allowed Domains for the JavaScript SDK" is unused (we do not load
#    FB.init). If Meta requires a value: http://localhost:8000 and
#    https://app.gearcloset.io — not www, and not the Supabase callback.
#
# Local `supabase start`: copy supabase/.env.example → supabase/.env and fill
# SUPABASE_AUTH_EXTERNAL_GOOGLE_* / SUPABASE_AUTH_EXTERNAL_FACEBOOK_*.
# Then restart the stack so config.toml [auth.external.*] can read them.

# Stripe
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET=
NUXT_STRIPE_WEBHOOK_SECRET=
# Set to true to show the Lifetime overlay and grant LIFE during onboarding.
# Set to false (or leave unset) to hide the overlay; new users stay on Free
# until they subscribe from Profile.
NUXT_PUBLIC_LIFETIME_PROMO=

# Transactional email (Resend). Auth confirm/reset stays on Supabase Auth templates.
# Needed for trip invite emails. Server only — do not prefix these with NUXT_PUBLIC_.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Gear Closet <noreply@mail.gearcloset.io>

# Sentry. Dev/local (`nuxt dev`) is off unless NUXT_PUBLIC_SENTRY_ENABLED=true
# and a DSN is set. Preview/prod send when a DSN is set, unless
# NUXT_PUBLIC_SENTRY_ENABLED=false. Server capture needs a production build
# (`pnpm build` + `pnpm preview`, or a deploy); `nuxt dev` does not init the
# server SDK. The public DSN is expected in the browser; NUXT_SENTRY_DSN is
# server-only and falls back to the public DSN if unset.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENABLED=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional. GET /api/sentry-example?key=... throws a test error when this matches.
NUXT_SENTRY_PROBE_KEY=
# Optional source-map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
